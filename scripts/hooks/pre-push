#!/usr/bin/env bash
#
# Last line of defence before anything leaves the machine.
#
# commit-msg catches a message as it is written. This catches what is actually
# being pushed — including commits made with --no-verify, commits authored
# before the hook existed, amended messages, and file content.
#
# Bypass, if you are certain: git push --no-verify

set -uo pipefail

list="$(git rev-parse --show-toplevel)/.scanned-domains"
[ -f "$list" ] || exit 0

domains=()
while IFS= read -r d; do
  d="${d%%#*}"; d="$(printf '%s' "$d" | tr -d '[:space:]')"
  [ -n "$d" ] && domains+=("$d")
done < "$list"
[ ${#domains[@]} -eq 0 ] && exit 0

fail=0
report() {
  [ "$fail" -eq 0 ] && printf '\n  PUSH BLOCKED — scanned domains in what you are about to publish.\n\n' >&2
  fail=1
  printf '    %s\n' "$1" >&2
}

zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="${remote_sha}..${local_sha}"; fi

  messages="$(git log --format='%B' "$range" 2>/dev/null || true)"
  content="$(git diff --unified=0 "$range" 2>/dev/null || true)"

  for d in "${domains[@]}"; do
    # Here-strings, not pipes. `grep -q` exits on first match and sends SIGPIPE
    # to the writer; under `set -o pipefail` that reports the pipeline as failed
    # and silently loses the match on large inputs — the bug hides on small
    # inputs and appears exactly where it matters.
    grep -qiF -- "$d" <<<"$messages" && report "$d — in a commit message"
    grep -qiF -- "$d" <<<"$content"  && report "$d — in file content"
  done
done

if [ "$fail" -eq 1 ]; then
  cat >&2 <<'TEXT'

  Rewrite the offending commits before pushing — amend if it is the tip,
  rebase otherwise. A pushed commit cannot be reliably retracted.

  If you are certain this is a false positive: git push --no-verify

TEXT
  exit 1
fi
exit 0
